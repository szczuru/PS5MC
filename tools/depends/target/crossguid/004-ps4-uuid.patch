+#ifdef GUID_PS4
+Guid newGuid()
+{
+	std::array<unsigned char, 16> data;
+	int fd = open("/dev/urandom", O_RDONLY);
+	if (fd < 0)
+		throw std::runtime_error("Unable to open /dev/urandom for GUID generation");
+	size_t offset = 0;
+	while (offset < data.size())
+	{
+		ssize_t count = read(fd, data.data() + offset, data.size() - offset);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count <= 0)
+		{
+			close(fd);
+			throw std::runtime_error("Unable to read /dev/urandom for GUID generation");
+		}
+		offset += static_cast<size_t>(count);
+	}
+	close(fd);
+	data[6] = static_cast<unsigned char>((data[6] & 0x0f) | 0x40);
+	data[8] = static_cast<unsigned char>((data[8] & 0x3f) | 0x80);
+	return Guid{std::move(data)};
+}
+#endif
