+#ifdef GUID_PS4
+Guid newGuid()
+{
+	std::array<unsigned char, 16> data;
+	arc4random_buf(data.data(), data.size());
+	data[6] = static_cast<unsigned char>((data[6] & 0x0f) | 0x40);
+	data[8] = static_cast<unsigned char>((data[8] & 0x3f) | 0x80);
+	return Guid{std::move(data)};
+}
+#endif
+
